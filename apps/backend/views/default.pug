doctype html
html(lang="en")
  head
    title #{app}
    style.
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; background: #f5f5f5; }
      .card { background: white; padding: 3rem; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); text-align: center; max-width: 480px; }
      h1 { color: #333; margin-bottom: 0.5rem; }
      p { color: #666; line-height: 1.6; }
      .badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; margin-top: 1rem; }
      .dev { background: #e3f2fd; color: #1976d2; }
      .prod { background: #fce4ec; color: #c62828; }
  body
    .card
      h1 #{app}
      p #{message}
      .badge(class=isProd ? 'prod' : 'dev')= environment
