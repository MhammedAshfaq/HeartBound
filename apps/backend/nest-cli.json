{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "db/drizzle/**/*",
      { "include": "../views/**/*", "outDir": "dist/views" },
      { "include": "../assets/**/*", "outDir": "dist/assets" }
    ],
    "watchAssets": true
  }
}
