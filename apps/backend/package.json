{
  "name": "backend",
  "version": "1.0.0",
  "description": "Healthy-Relationship NestJS Backend",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "copy:assets": "cpy \"views/**/*\" \"assets/**/*\" --parents --cwd=. dist",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "build:api": "nest build && pnpm run copy:assets",
    "build:worker": "tsc -p tsconfig.build.json",
    "build": "concurrently --names \"API,WORKER\" --prefix-colors \"cyan,magenta\" \"pnpm run build:api\" \"pnpm run build:worker\"",
    "api:start": "nest start",
    "api:start:dev": "nest start --watch",
    "api:start:prod": "node dist/main",
    "worker:start": "ts-node -r tsconfig-paths/register src/worker.main.ts",
    "worker:start:dev": "ts-node-dev -r tsconfig-paths/register --respawn src/worker.main.ts",
    "worker:start:prod": "node dist/worker.main.js",
    "start": "concurrently --names \"API,WORKER\" --prefix-colors \"cyan,magenta\" \"pnpm run api:start\" \"pnpm run worker:start\"",
    "start:dev": "concurrently --names \"API,WORKER\" --prefix-colors \"cyan,magenta\" \"pnpm run api:start:dev\" \"pnpm run worker:start:dev\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "db:dev:up": "docker compose up -d",
    "db:dev:rm": "docker compose down --volumes --remove-orphans",
    "prisma:dev:deploy": "prisma migrate deploy --schema=./src/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./src/db/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=./src/db/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./src/db/prisma/schema.prisma",
    "prisma:setup": "pnpm run prisma:migrate && pnpm run prisma:generate",
    "local:up": "pnpm run db:dev:up && sleep 5 && pnpm run prisma:setup && pnpm run start:dev",
    "generate:prometheus": "node scripts/generate-prometheus.js",
    "clean": "rimraf dist coverage",
    "type-check": "tsc --noEmit",
    "postinstall": "pnpm run prisma:generate"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.3",
    "@nestjs/cache-manager": "3.0.1",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.1",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.64.1",
    "@opentelemetry/context-async-hooks": "2.1.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.205.0",
    "@opentelemetry/resources": "2.1.0",
    "@opentelemetry/sdk-node": "0.205.0",
    "@prisma/client": "6.16.2",
    "@willsoto/nestjs-prometheus": "6.0.2",
    "body-parser": "2.2.0",
    "bullmq": "5.58.6",
    "cache-manager": "7.2.0",
    "cache-manager-redis-store": "3.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "joi": "18.0.1",
    "nest-winston": "1.10.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "pug": "3.0.3",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.2",
    "winston": "3.17.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@playwright/test": "1.55.0",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "concurrently": "6.1.0",
    "cpy-cli": "6.0.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.1.3",
    "playwright": "1.55.0",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.3",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
